# All optional. The app runs with none of these set.

# Passcode for the SIMULATED verifier login (default: demo-verifier)
VERIFIER_PASSCODE=demo-verifier

# Where verifier edits are stored (SQLite file). Default: ./.data/verifier.db
# On Vercel the default is /tmp/verifier.db, which resets on each cold start.
# VERIFIER_DB_PATH=./.data/verifier.db

# VA Facilities API key for scripts/import-va-facilities.mjs (skipped if absent)
# VA_FACILITIES_API_KEY=

# Stretch feature 6: conversational navigator. Off unless ENABLE_CHAT=true.
# Works with keyword matching alone; uses the Anthropic API only if a key is set.
# ENABLE_CHAT=true
# ANTHROPIC_API_KEY=
