# All optional. The app runs with none of these set: listings work, and every
# text, call and letter is simulated (nothing is sent).

# Public web address, used in texts, sitemap and Twilio signature checks.
# PUBLIC_SITE_URL=https://vets.example.org

# ---- Verifiers (people who check listings) --------------------------------
# Passcode for the SIMULATED verifier login (default: demo-verifier)
VERIFIER_PASSCODE=demo-verifier
# Where verifier edits and public reports are stored. Default: ./.data/verifier.db
# VERIFIER_DB_PATH=./.data/verifier.db

# ---- Outreach: updates by text, phone call and mail -----------------------
# Real messages go out ONLY when OUTREACH_LIVE=true AND every item on the staff
# dashboard's "Ready to go live?" checklist is done. Otherwise it is simulated.
# OUTREACH_LIVE=true

# Staff passcode, 12+ characters. Until set, staff screens hide all personal
# details and the demo passcode is demo-outreach.
# OUTREACH_PASSCODE=

# 32 random bytes that encrypt phone numbers, names and addresses.
# Make one with: openssl rand -hex 32   Back it up: without it the data is unreadable.
# OUTREACH_ENCRYPTION_KEY=

# Where subscriber data lives. Must survive restarts (a disk or volume).
# Default: ./.data/outreach.db
# OUTREACH_DB_PATH=./.data/outreach.db

# Name at the start of every text and call. Default: Veteran Services Navigator
# OUTREACH_SENDER_NAME=Veteran Services Navigator

# Return address printed on letters and the paper sign-up form. Use | between lines.
# OUTREACH_RETURN_ADDRESS=Veteran Services Navigator|PO Box 0000|Fredericksburg, VA 22401

# Twilio, for the text line, phone line and sending. Register the number for
# A2P 10DLC before texting. Point its webhooks at /api/sms and /api/voice.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15405550100
# TWILIO_MESSAGING_SERVICE_SID=

# Demos and tests only: let SIMULATED sends run outside 8 a.m.-9 p.m. Eastern.
# Ignored when outreach is live.
# OUTREACH_DEMO_ANY_HOUR=true

# ---- Data import -----------------------------------------------------------
# VA Facilities API key for scripts/import-va-facilities.ts (skipped if absent)
# VA_FACILITIES_API_KEY=

# ---- Stretch feature 6: conversational navigator ---------------------------
# Off unless ENABLE_CHAT=true. Works with keyword matching alone; uses the
# Anthropic API only if a key is set.
# ENABLE_CHAT=true
# ANTHROPIC_API_KEY=
